{
  "version": 8,
  "name": "Activity Heatmap",
  "metadata": {
    "maplibre:notes": "Base map uses OSM raster tiles as a placeholder. Swap the 'osm-tiles' source with your real basemap (vector or raster) as needed."
  },
  "sources": {
    "tracks-source": {
      "type": "geojson",
      "data": "/api/heatmap"
    }
  },
  "layers": [
    {
      "id": "tracks-glow",
      "type": "line",
      "source": "tracks-source",
      "paint": {
        "line-color": [
          "interpolate",
          ["linear"],
          ["get", "count"],
          1,
          "rgb(255, 77, 0)",
          10,
          "rgb(255, 130, 60)",
          50,
          "rgb(255, 180, 130)",
          100,
          "rgb(255, 220, 190)"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          ["interpolate", ["linear"], ["get", "count"], 1, 1.5, 100, 4],
          12,
          ["interpolate", ["linear"], ["get", "count"], 1, 2.5, 100, 6],
          16,
          ["interpolate", ["linear"], ["get", "count"], 1, 3.5, 100, 8]
        ],
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["get", "count"],
          1,
          0.35,
          20,
          0.5,
          100,
          0.6
        ],
        "line-blur": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          1.4,
          12,
          1.0,
          18,
          0.8
        ]
      }
    },
    {
      "id": "tracks-core",
      "type": "line",
      "source": "tracks-source",
      "paint": {
        "line-color": [
          "interpolate",
          ["linear"],
          ["get", "count"],
          1,
          "rgb(255, 77, 0)",
          10,
          "rgb(255, 110, 40)",
          50,
          "rgb(255, 150, 90)",
          100,
          "rgb(255, 195, 150)"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          ["interpolate", ["linear"], ["get", "count"], 1, 0.6, 100, 2.2],
          12,
          ["interpolate", ["linear"], ["get", "count"], 1, 0.9, 100, 2.8],
          16,
          ["interpolate", ["linear"], ["get", "count"], 1, 1.2, 100, 3.4]
        ],
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["get", "count"],
          1,
          0.65,
          20,
          0.8,
          100,
          0.95
        ],
        "line-blur": 0
      }
    }
  ]
}
