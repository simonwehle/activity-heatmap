{
  "version": 8,
  "name": "Activity Heatmap",
  "metadata": {
    "maplibre:notes": "Base map uses OSM raster tiles as a placeholder. Swap the 'osm-tiles' source with your real basemap (vector or raster) as needed."
  },
  "sources": {
    "tracks-source": {
      "type": "geojson",
      "data": "/api/heatmap"
    }
  },
  "layers": [
    {
      "id": "tracks-glow",
      "type": "line",
      "source": "tracks-source",
      "paint": {
        "line-color": [
          "match",
          ["get", "activity_type"],
          "running",
          "#F27716",
          "cycling",
          "#16A544",
          "swimming",
          "#1976D2",
          "walking",
          "#40C35D",
          "hiking",
          "#E02C2C",
          "multisport",
          "#E02C2C",
          "cross_country_skiing",
          "#3B97F3",
          "alpine_skiing",
          "#3B97F3",
          "snowboarding",
          "#3B97F3",
          "#F27716"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          ["interpolate", ["linear"], ["get", "count"], 1, 1.5, 100, 4],
          12,
          ["interpolate", ["linear"], ["get", "count"], 1, 2.5, 100, 6],
          16,
          ["interpolate", ["linear"], ["get", "count"], 1, 3.5, 100, 8]
        ],
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["get", "count"],
          1,
          0.35,
          20,
          0.5,
          100,
          0.6
        ],
        "line-blur": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          1.4,
          12,
          1.0,
          18,
          0.8
        ]
      }
    },
    {
      "id": "tracks-core",
      "type": "line",
      "source": "tracks-source",
      "paint": {
        "line-color": [
          "match",
          ["get", "activity_type"],
          "running",
          "#F27716",
          "cycling",
          "#16A544",
          "swimming",
          "#1976D2",
          "walking",
          "#40C35D",
          "hiking",
          "#E02C2C",
          "multisport",
          "#E02C2C",
          "cross_country_skiing",
          "#3B97F3",
          "alpine_skiing",
          "#3B97F3",
          "snowboarding",
          "#3B97F3",
          "#F27716"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          ["interpolate", ["linear"], ["get", "count"], 1, 0.6, 100, 2.2],
          12,
          ["interpolate", ["linear"], ["get", "count"], 1, 0.9, 100, 2.8],
          16,
          ["interpolate", ["linear"], ["get", "count"], 1, 1.2, 100, 3.4]
        ],
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["get", "count"],
          1,
          0.65,
          20,
          0.8,
          100,
          0.95
        ],
        "line-blur": 0
      }
    }
  ]
}
